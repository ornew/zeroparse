go 1.27.1

use (
	.
	./runtime
	./site
)

// The root module requires the runtime module at a placeholder until the commit that adds the
// runtime module is published; the go command reads the go.mod of a required version even for a
// module of the workspace, so the placeholder is mapped back to the workspace.
replace zeroparse.dev/zp/runtime v0.0.0-00010101000000-000000000000 => ./runtime
